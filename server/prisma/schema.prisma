generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SQLite (dev) does not support native enums, so role/type/status fields are
// plain strings validated against the constants in src/lib/constants.js.
// PostgreSQL (prod) migration can reintroduce native enums if desired.

model User {
  id           String    @id @default(cuid())
  role         String    @default("STUDENT")
  login        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  university   String?
  email        String    @unique
  points       Int       @default(0)
  createdAt    DateTime  @default(now())
  // WebSocket uzilib qolsa ham "onlayn" holati saqlanib qolishi uchun —
  // presence endi faqat xotiradagi Map'ga bog'liq emas (src/lib/presence.js).
  lastSeenAt   DateTime?

  posts          Post[]
  comments       Comment[]
  postLikes      PostLike[]
  pollVotes      PollVote[]
  lessonProgress LessonProgress[]
  submissions    Submission[]
  materials      Material[]
  forumThreads   ForumThread[]
  forumReplies   ForumReply[]
  uploadedFiles  UploadedFile[]
  notifications  Notification[]
  dailyActivity  DailyActivity[]
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  purpose   String
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Banner {
  id      String        @id @default(cuid())
  title   String
  text    String
  color   String
  order   Int           @default(0)
  imageId String?
  image   UploadedFile? @relation(fields: [imageId], references: [id])
}

// Blog-uslubidagi post: sarlavha majburiy, qolgan hammasi ixtiyoriy —
// tavsif matni, rasm YOKI YouTube video havolasi (dars videosi kabi).
model Post {
  id          String        @id @default(cuid())
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  title       String
  text        String?
  videoUrl    String?
  imageId     String?
  image       UploadedFile? @relation(fields: [imageId], references: [id])
  createdAt   DateTime      @default(now())
  // Blog: qoralama / rejalashtirilgan e'lon / rukn (teg) / tepaga qadash.
  // status: "DRAFT" yoki "PUBLISHED"; publishedAt kelajakda bo'lsa — post
  // o'sha vaqt kelgunicha talabalarga ko'rinmaydi (rejalashtirilgan e'lon).
  status      String        @default("PUBLISHED")
  publishedAt DateTime?
  pinned      Boolean       @default(false)
  tags        String?
  likes       PostLike[]
  comments    Comment[]
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())
}

model Poll {
  id        String       @id @default(cuid())
  question  String
  multiple  Boolean      @default(false)
  createdAt DateTime     @default(now())
  options   PollOption[]
}

model PollOption {
  id      String     @id @default(cuid())
  pollId  String
  poll    Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text    String
  correct Boolean    @default(false)
  order   Int        @default(0)
  votes   PollVote[]
}

model PollVote {
  id           String     @id @default(cuid())
  pollOptionId String
  option       PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([pollOptionId, userId])
}

model Topic {
  id      String   @id @default(cuid())
  title   String
  order   Int      @default(0)
  lessons Lesson[]
}

// type: VIDEO | TEXT | TEST | LIVE
// LIVE — jonli dars: tashqi uchrashuv havolasi (Zoom/Meet) va boshlanish vaqti.
model Lesson {
  id           String           @id @default(cuid())
  topicId      String
  topic        Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title        String
  type         String
  videoUrl     String?
  content      String?
  order        Int              @default(0)
  meetingUrl   String?
  startsAt     DateTime?
  // TEST sozlamalari: o'tish balli (%), vaqt chegarasi, savollarni aralashtirish,
  // urinishlar soni (null — cheksiz).
  passScore    Int              @default(60)
  timeLimitSec Int?
  shuffle      Boolean          @default(false)
  maxAttempts  Int?
  questions    Question[]
  materials    LessonMaterial[]
  progress     LessonProgress[]
}

model LessonMaterial {
  id       String       @id @default(cuid())
  lessonId String
  lesson   Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  fileId   String
  file     UploadedFile @relation(fields: [fileId], references: [id])
  order    Int          @default(0)
}

model Question {
  id       String           @id @default(cuid())
  lessonId String
  lesson   Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  text     String
  order    Int              @default(0)
  options  QuestionOption[]
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  correct    Boolean  @default(false)
  order      Int      @default(0)
}

model LessonProgress {
  id          String    @id @default(cuid())
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  completed   Boolean   @default(false)
  score       Int?
  attempts    Int       @default(0)
  completedAt DateTime?

  @@unique([lessonId, userId])
}

// type: "FILE" (talaba fayl yuklab topshiradi, o'qituvchi qo'lda baholaydi)
// yoki "TEST" (o'qituvchi ~ == ++++ formatidagi fayl yuklaydi, talaba
// savollarga javob beradi, ball avtomatik hisoblanadi — darslardagi TEST
// darsi bilan bir xil mantiq, lekin alohida vazifa sifatida).
model Assignment {
  id          String               @id @default(cuid())
  title       String
  description String
  type        String               @default("FILE")
  maxScore    Int
  dueDate     DateTime
  createdAt   DateTime             @default(now())
  steps       AssignmentStep[]
  materials   AssignmentMaterial[]
  questions   AssignmentQuestion[]
  submissions Submission[]
}

model AssignmentQuestion {
  id           String                     @id @default(cuid())
  assignmentId String
  assignment   Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  text         String
  order        Int                        @default(0)
  options      AssignmentQuestionOption[]
}

model AssignmentQuestionOption {
  id         String             @id @default(cuid())
  questionId String
  question   AssignmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  correct    Boolean            @default(false)
  order      Int                @default(0)
}

model AssignmentStep {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  title        String
  text         String
  order        Int        @default(0)
}

model AssignmentMaterial {
  id           String       @id @default(cuid())
  assignmentId String
  assignment   Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fileId       String
  file         UploadedFile @relation(fields: [fileId], references: [id])
}

model Submission {
  id           String        @id @default(cuid())
  assignmentId String
  assignment   Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User          @relation(fields: [studentId], references: [id])
  // TEST turidagi vazifada fayl bo'lmaydi — ball avtomatik hisoblanadi.
  fileId       String?
  file         UploadedFile? @relation(fields: [fileId], references: [id])
  submittedAt  DateTime      @default(now())
  // Talabaning ishga qo'shimcha izohi (ixtiyoriy).
  text         String?
  score        Int?
  comment      String?
  status       String        @default("NOT_REVIEWED")
  // Bir nechta fayl. `fileId` birinchi faylga ishora qilib qoladi — eski
  // yozuvlar va fayl ruxsatlarini tekshirish shunga tayanadi.
  files        SubmissionFile[]

  @@unique([assignmentId, studentId])
}

model Material {
  id           String       @id @default(cuid())
  title        String
  fileId       String
  file         UploadedFile @relation(fields: [fileId], references: [id])
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime     @default(now())
}

model ForumThread {
  id        String       @id @default(cuid())
  title     String
  // Mavzu matni. Ilgari u birinchi "javob" sifatida saqlanardi — o'sha javob
  // o'chirilsa mavzu matnsiz qolardi.
  body      String?
  authorId  String
  author    User         @relation(fields: [authorId], references: [id])
  createdAt DateTime     @default(now())
  replies   ForumReply[]
}

model ForumReply {
  id        String      @id @default(cuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime    @default(now())
}

model UploadedFile {
  id           String   @id @default(cuid())
  originalName String
  storedName   String
  mimeType     String
  size         Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  assignmentMaterials AssignmentMaterial[]
  lessonMaterials     LessonMaterial[]
  submissionFiles     SubmissionFile[]
  submissions         Submission[]
  materials           Material[]
  banners             Banner[]
  posts               Post[]
}

// Ichki bildirishnomalar (yangi vazifa, baho, forumdagi javob, jonli dars...).
// WebSocket orqali darhol yetkaziladi, o'qilmaganlari qo'ng'iroqchada sanaladi.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// Kunlik faollik — dashboarddagi "tashriflar" grafigi uchun HAQIQIY ma'lumot
// (ilgari grafik Math.random() bilan chizilardi). Har bir foydalanuvchi uchun
// kuniga bitta yozuv: presence.touch() uni upsert qiladi.
model DailyActivity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String

  @@unique([userId, day])
  @@index([day])
}

// Talaba javobiga biriktirilgan fayllar. Ilgari javobda faqat BITTA fayl
// bo'lardi va 10MB chegarasiga sig'masa, ishni bo'lib yuborishning iloji
// yo'q edi.
model SubmissionFile {
  id           String       @id @default(cuid())
  submissionId String
  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fileId       String
  file         UploadedFile @relation(fields: [fileId], references: [id])
  order        Int          @default(0)

  @@index([submissionId])
}
